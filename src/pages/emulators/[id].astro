---
import EmulatorList from "../../emulators.json";
import Layout from "@layout";
export async function getStaticPaths() {
  return EmulatorList.map((Emulator) => {
    return {
      params: { id: Emulator.id },
      props: {
        title: Emulator.title,
        description: Emulator.description,
        file: Emulator.file
      }
    };
  });
}
const { id } = Astro.params;
const { title, description, file } = Astro.props;
---

<Layout title={title}>
  <div class="theaterContainer">
    <a class="theaterBack" href="/emulators">&larr; All emulators</a>
    <div class="theaterCard">
      <iframe
        class="theaterViewport"
        id="theaterViewport"
        src={"/~/uv/" + encodeURIComponent(file)}
        >Your browser doesn't support iframes.</iframe
      >
      <div class="theaterBar">
        <div class="theaterMeta">
          <h1 class="theaterTitle">{title}</h1>
          <p class="theaterDesc">{description}</p>
        </div>
        <div class="theaterButtons">
          <button
            class="theaterButton"
            title="Fullscreen"
            aria-label="Fullscreen"
            onclick="handleFullscreenClick();"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 9V5a1 1 0 0 1 1-1h4M20 9V5a1 1 0 0 0-1-1h-4M4 15v4a1 1 0 0 0 1 1h4M20 15v4a1 1 0 0 1-1 1h-4"
              ></path>
            </svg>
          </button>
          <button
            class="theaterButton"
            title="Open in new tab"
            aria-label="Open in new tab"
            onclick="Popout();"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14 4h6v6M20 4l-9 9M20 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h5"
              ></path>
            </svg>
          </button>
          <button
            class="theaterButton theaterButton-text"
            title="Open in about:blank window"
            aria-label="Open in about:blank window"
            onclick="ABPopout();"
          >
            a:b
          </button>
          <button
            class="theaterButton"
            title="Open in blob window"
            aria-label="Open in blob window"
            onclick="BlobPopout();"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 3s6 6.6 6 11a6 6 0 0 1-12 0c0-4.4 6-11 6-11z"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <script is:inline>
    function handleFullscreenClick() {
      let iframe = document.getElementById("theaterViewport");

      if (iframe.requestFullscreen) {
        iframe.requestFullscreen();
      } else if (iframe.mozRequestFullScreen) {
        iframe.mozRequestFullScreen();
      } else if (iframe.webkitRequestFullscreen) {
        iframe.webkitRequestFullscreen();
      } else if (iframe.msRequestFullscreen) {
        iframe.msRequestFullscreen();
      }
    }

    function Popout() {
      let iframe = document.getElementById("theaterViewport");
      let src = iframe.getAttribute("src");
      window.open(src);
    }

    function ABPopout() {
      let theateriframe = document.getElementById("theaterViewport");
      let src = theateriframe.getAttribute("src");
      var newWindow = window.open("about:blank");
      var iframe = document.createElement("iframe");
      iframe.src = window.location.origin + src;
      iframe.style.width = "100%";
      iframe.style.height = "100%";
      iframe.style.border = "none";
      iframe.style.overflow = "hidden";
      newWindow.document.body.appendChild(iframe);
    }

    function BlobPopout() {
      let theateriframe = document.getElementById("theaterViewport");
      let src = theateriframe.getAttribute("src");
      var newWindow = window.open(
        URL.createObjectURL(
          new Blob(["<html><body></body></html>"], {
            type: "text/html"
          })
        ),
        "_blank"
      );
      var iframe = document.createElement("iframe");
      iframe.src = window.location.origin + src;
      iframe.style.width = "100%";
      iframe.style.height = "100%";
      iframe.style.border = "none";
      iframe.style.overflow = "hidden";

      newWindow.onload = function () {
        newWindow.onload = null;

        newWindow.document.body.style.background = "black";
        newWindow.document.body.appendChild(iframe);
        newWindow.document.body.style.width = "100%";
        newWindow.document.body.style.height = "100%";
        newWindow.document.body.style.margin = "0";
        newWindow.document.body.style.padding = "0";
      };
    }
  </script>
</Layout>

<style>
  .theaterContainer {
    color: var(--font-color);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 16px 48px;
  }

  .theaterBack {
    align-self: flex-start;
    margin: 0 auto 10px;
    width: min(1100px, 100%);
    color: var(--nav-btn-color-darker);
    font-size: 14px;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .theaterBack:hover {
    color: var(--nav-btn-color);
  }

  .theaterCard {
    width: min(1100px, 100%);
    border: 1px solid rgb(var(--accent), 0.25);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--settings-1);
    box-shadow:
      var(--shadow-3),
      0 0 40px -14px rgb(var(--accent), 0.4);
  }

  .theaterViewport {
    display: block;
    border: none;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: calc(100vh - 260px);
    min-height: 320px;
    background: #000;
  }

  .theaterBar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
    border-top: 1px solid rgb(var(--accent), 0.2);
    flex-wrap: wrap;
  }

  .theaterMeta {
    min-width: 0;
  }

  .theaterTitle {
    font-size: 18px;
    margin: 0;
  }

  .theaterDesc {
    font-size: 13px;
    color: var(--nav-btn-color-darker);
    margin: 2px 0 0;
  }

  .theaterButtons {
    display: flex;
    gap: 8px;
    flex: none;
  }

  .theaterButton {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    min-width: 36px;
    padding: 0 8px;
    color: var(--font-color);
    background: rgb(var(--accent), 0.06);
    border: 1px solid rgb(var(--accent), 0.3);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .theaterButton:hover {
    background: rgb(var(--accent), 0.15);
    border-color: rgb(var(--accent), 0.55);
  }

  .theaterButton-text {
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
</style>
