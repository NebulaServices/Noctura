---
// @ts-nocheck
import Plugins from "@plugins";
import Section from "@components/Section.astro";

var proxy = [
    {
        name: "AdBlocker",
        author: "avd3",
        url: "/js/scripts/adBlocker.js",
        description: "Works on all proxies. IT DOES NOT (sylvie)",
        id: "proxy-0002"
    },
    {
        name: "Dark Mode",
        author: "Riftriot",
        url: "/js/scripts/darkMode.js",
        description: "If the website is not in dark mode, this script will invert all colors on the website.",
        id: "proxy-0003"
    },
    {
        name: ":3",
        author: "avd3",
        url: "/js/scripts/3.js",
        description: ":3",
        id: "proxy-0004"
    }
]

var modules = [
    {
        name: "Change something",
        author: "Riftriot",
        url: "/js/testscript.js",
        description: "Change something in homepage",
        id: "module-0001"
    }
]
---

<Plugins title="User Scripts">
    <style>
        .selected-opt {
            background: var(--settings-3) !important;
        }

        .plugin-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
            gap: 16px;
            margin-top: 12px;
            text-align: left;
        }

        .plugin-card {
            display: flex;
            flex-direction: column;
            padding: 14px 16px 16px;
            border: 1px solid var(--settings-3);
            border-radius: var(--radius-lg);
            background: var(--settings-1);
            color: var(--font-color);
            transition:
                transform var(--dur-med) var(--ease),
                border-color var(--dur-med) var(--ease),
                box-shadow var(--dur-med) var(--ease);
        }

        .plugin-card:hover {
            transform: translateY(-3px);
            border-color: rgb(var(--accent), 0.5);
            box-shadow: var(--shadow-2);
        }

        .plugin-card h2 {
            font-size: 17px;
            margin: 0;
        }

        .plugin-card h3 {
            font-size: 12px;
            font-weight: 400;
            color: var(--nav-btn-color-darker);
            margin: 2px 0 0;
        }

        .plugin-card p {
            font-size: 13px;
            line-height: 1.5;
            color: var(--nav-btn-color-darker);
            margin: 8px 0 0;
            flex: 1;
        }

        .script-button {
            margin-top: 14px;
            padding: 9px 0;
            width: 100%;
            text-align: center;
            font-weight: 600;
            font-size: 14px;
            color: var(--font-color);
            border: 1px solid var(--settings-3);
            border-radius: var(--radius-md);
            background: var(--settings-2);
            transition:
                background var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease);
        }

        .script-button:hover {
            background: rgb(var(--accent), 0.2);
            border-color: rgb(var(--accent), 0.5);
        }
    </style>

    <Section>
        <h1 class="text-xl">Proxy Injection Scripts</h1>
        <p>Scripts run inside every page you browse through the proxy, after Scramjet rewrites it.</p>
        <p>Usermade scripts are not supported because it's very easy to make a script to steal your information.</p>
        <div class="plugin-grid">
            {
                proxy.map((script) => (
                    <div id={script.id} class="plugin-card">
                        <h2>{script.name}</h2>
                        <h3>by {script.author}</h3>
                        <p>{script.description.length > 100 ? script.description.split('').slice(0, 100).join('') + '...' : script.description}</p>
                        <button class="script-button" data-url={script.url} data-script={btoa(JSON.stringify(script))}>
                            <span class="installtext" data-id={script.id}>Install</span>
                        </button>
                    </div>
                ))
            }
        </div>
    </Section>

    <Section>
        <h1 class="text-xl">Noctura Module Scripts</h1>
        <p>Scripts are run on Noctura page loads (excluding router loads)</p>
        <div class="plugin-grid">
            {
                modules.map((script) => (
                    <div id={script.id} class="plugin-card">
                        <h2>{script.name}</h2>
                        <h3>by {script.author}</h3>
                        <p>{script.description.length > 100 ? script.description.split('').slice(0, 100).join('') + '...' : script.description}</p>
                        <button class="script-button" data-url={script.url} data-script={btoa(JSON.stringify(script))}>
                            <span class="installtext" data-id={script.id}>Install</span>
                        </button>
                    </div>
                ))
            }
        </div>
    </Section>

    <Section>
        <h1 class="text-xl">Script Editor</h1>
        <p>very cool</p>
        <button class="plugins-submit" onclick="window.setInject(this); ">Proxy Injection</button>
        <button class="plugins-submit mb-1" onclick="window.setModule(this); ">Noctura Module</button>
        <div id="monaco-editor"></div>
        <button class="plugins-submit" onclick="window.saveEdits();">Save</button>
    </Section>

    <script type="module">
// @ts-nocheck
        const scripts = await caches.open('astro-scripts');
        const modules = await caches.open('astro-modules');

        document.querySelectorAll(".installtext").forEach((text) => {
            const scriptInfo = (JSON.parse(localStorage.getItem("scripts")) || {})[text.dataset.id];

            (!scriptInfo || scriptInfo === "uninstalled") ? text.innerText = "Install" : text.innerText = "Uninstall";
        });

        document.querySelectorAll(".script-button").forEach(btn => {
            btn.addEventListener("click", () => {
                const script = JSON.parse(atob(btn.dataset.script));

                scriptEvent(script);
            })
        })

        window.scriptEvent = (script) => {
            const type = script.id.split("-")[0];
            const scriptInfo = (JSON.parse(localStorage.getItem("scripts") || "{}"))[script.id];

            if (type === "proxy") {
                (!scriptInfo || scriptInfo === "uninstalled") ? window.installScript(script) : window.uninstallScript(script);
            } else if (type === "module") {
                (!scriptInfo || scriptInfo === "uninstalled") ? window.installModule(script) : window.uninstallModule(script);
            }
        }

        const reqScript = (url) => {
            return new Promise((resolve, reject) => {
                fetch(url).then((res) => {
                    res.text().then((text) => {
                        resolve(text)
                    })
                })
            })
        }

        const setScript = (id, type) => {
            const scripts = JSON.parse(localStorage.getItem("scripts")) || {};
            scripts[id] = type;
            localStorage.setItem("scripts", JSON.stringify(scripts));
        }

        // (un)install scripts will load information into localStorage instead because it is loaded into memory (faster)

        window.installScript = async (script) => {
            notify.show("Fetching Data", "info", 2000);

            const data = await reqScript(script.url);

            await notify.hide();
            notify.show("Installing Script", "info", 2000);

            await scripts.put('/' + script.id + '.js', new Response(data, {
                headers: {
                    'Content-Type': 'text/javascript'
                }
            }));

            await notify.hide();
            notify.show("Script Installed", "success", 2000);

            document.querySelector(`.installtext[data-id=${script.id}]`).innerText = "Uninstall";
            setScript(script.id, "installed");
        }

        window.uninstallScript = async (script) => {
            notify.show("Uninstalling Script", "info", 2000);
            await notify.hide();
            await scripts.delete("/" + script.id + ".js");

            await notify.hide();
            notify.show("Script Uninstalled", "success", 2000);

            document.querySelector(`.installtext[data-id=${script.id}]`).innerText = "Install";
            setScript(script.id, "uninstalled");
        }

        window.installModule = async (script) => {
            notify.show("Fetching Data", "info", 2000);

            const data = await reqScript(script.url);

            await notify.hide();
            notify.show("Installing Module", "info", 2000);

            await modules.put('/' + script.id + '.js', new Response(data, {
                headers: {
                    'Content-Type': 'application/javascript'
                }
            }));

            await notify.hide();
            notify.show("Module Installed", "success", 2000);

            document.querySelector(`.installtext[data-id=${script.id}]`).innerText = "Uninstall";
            setScript(script.id, "installed");
        }

        window.uninstallModule = async (script) => {
            notify.show("Uninstalling Script", "info", 2000);
            await notify.hide();
            await modules.delete("/" + script.id + ".js");

            await notify.hide();
            notify.show("Script Uninstalled", "success", 2000);

            document.querySelector(`.installtext[data-id=${script.id}]`).innerText = "Install";
            setScript(script.id, "uninstalled");
        }
    </script>

    <script>
// @ts-nocheck
        import createEditor from "../../js/editor";

        const view = createEditor("js");

        window.moduleText =
    `// Runs on every Noctura page load (excluding router navigations).
    `

        window.injectText =
    `// Runs inside every page browsed through the proxy,
    // injected after Scramjet rewrites the document.
    // document and window belong to the proxied page itself.

    // CODE HERE`;

        window.setInject = (that) => {that.classList.add('selected-opt'); that.nextElementSibling.classList.remove('selected-opt'); window.editing = 'inject'; view ? view.dispatch({ startState: view.state, changes: { from: 0, to: view.viewport.to, insert: localStorage.getItem("saved-inject") || injectText } }) : window.defaultText = injectText};
        window.setModule = (that) => {that.classList.add('selected-opt'); that.previousElementSibling.classList.remove('selected-opt'); window.editing = 'module'; view ? view.dispatch({ startState: view.state, changes: { from: 0, to: view.viewport.to, insert: localStorage.getItem("saved-module") || moduleText } }) : window.defaultText = moduleText};

        window.saveEdits = async function() {
            const script = view.state.doc.toString()
                switch(window.editing) {
                    case "inject": {
                        let cache = await caches.open("astro-scripts");
                        localStorage.setItem('saved-inject', script);
                        await cache.put('/custom.js', new Response(script, { headers: { 'Content-Type': 'application/javascript' } }));

                        await notify.hide();
                        notify.show("Saved Script", "success", 2000);
                        break;
                    }
                    case "module": {
                        let cache = await caches.open("astro-modules");
                        localStorage.setItem('saved-module', script);
                        await cache.put('/custom.js', new Response(script, { headers: { 'Content-Type': 'application/javascript' } }));

                        await notify.hide();
                        notify.show("Saved Module", "success", 2000);
                        break;
                    }
                    default: {
                        Function(script)();
                        break;
                    }
                }
            }
    </script>
</Plugins>
