  <script is:inline>
    (function () {
      const widgets = document.querySelectorAll(".corner-widget");
      const swatches = document.querySelectorAll(".theme-swatch");
      const presets = document.querySelectorAll(".cloak-preset");

      const customProps = [
        "--primary-bg-color",
        "--secondary-bg-color",
        "--surface-2",
        "--settings-1",
        "--settings-2",
        "--settings-3",
        "--font-color",
        "--primary-text-color",
        "--nav-btn-color-darker",
        "--nav-btn-color",
        "--logo-color",
        "--banner-gradient",
        "--borders-1",
        "--borders-2"
      ];

      function sync() {
        const current = localStorage.getItem("theme") || "amoled";
        swatches.forEach((s) =>
          s.classList.toggle("active", s.dataset.themeId == current)
        );
        const title = localStorage.getItem("savedTitle");
        presets.forEach((p) =>
          p.classList.toggle("active", p.dataset.name == title)
        );
      }

      function pushCloak() {
        if (navigator.serviceWorker && navigator.serviceWorker.controller)
          navigator.serviceWorker.controller.postMessage("updateCloak");
        if (window.titleLoad) window.titleLoad();
        if (window.faviconLoad) window.faviconLoad();
      }

      widgets.forEach((w) => {
        const toggle = w.querySelector(".corner-toggle");
        const panel = w.querySelector(".corner-panel");

        toggle.onclick = function (e) {
          e.stopPropagation();
          document.querySelectorAll(".corner-panel.open").forEach((p) => {
            if (p !== panel) p.classList.remove("open");
          });
          panel.classList.toggle("open");
          sync();
        };
      });

      swatches.forEach(
        (s) =>
          (s.onclick = function (e) {
            e.stopPropagation();
            const id = s.dataset.themeId;
            localStorage.setItem("theme", id);
            customProps.forEach((p) =>
              document.documentElement.style.removeProperty(p)
            );
            document.documentElement.setAttribute("data-theme", id);
            sync();
          })
      );

      presets.forEach(
        (p) =>
          (p.onclick = function (e) {
            e.stopPropagation();
            localStorage.setItem("savedTitle", p.dataset.name);
            localStorage.setItem(
              "savedFavicon",
              p.querySelector("img").currentSrc || p.querySelector("img").src
            );
            localStorage.removeItem("autoURL");
            pushCloak();
            sync();
          })
      );

      document.getElementById("cloak-reset").onclick = function () {
        localStorage.setItem("savedTitle", "Noctura");
        localStorage.setItem("savedFavicon", "/icon.png");
        localStorage.removeItem("autoURL");
        pushCloak();
        sync();
      };

      document.addEventListener(
        "pointerdown",
        function (e) {
          widgets.forEach((w) => {
            if (!w.contains(e.target))
              w.querySelector(".corner-panel").classList.remove("open");
          });
        },
        true
      );

      sync();
    })();
  </script>

