---
import "./tabs.css";
---

<aside class="tabs-dock" id="tabs-dock">
  <div class="tabs-stack" id="tabs-list" role="list"></div>

  <button
    type="button"
    class="tabs-toggle"
    id="tabs-btn"
    aria-label="Open tabs"
    aria-expanded="false"
  >
    <svg
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"
      stroke-linecap="round"
    >
      <path d="M12 3 3 8l9 5 9-5-9-5z"></path>
      <path d="m3 13 9 5 9-5"></path>
    </svg>
    <span class="tabs-count" id="tabs-count" hidden></span>
  </button>
</aside>
